# Configuración del Broker MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=sensors/+/telemetry

# Configuración de InfluxDB TSDB
INFLUXDB_INIT_USERNAME=iotuser
INFLUXDB_INIT_PASSWORD=iotpassword123
INFLUXDB_INIT_ORG=iot-lab
INFLUXDB_INIT_BUCKET=telemetry
INFLUXDB_INIT_ADMIN_TOKEN=iot-lab-super-secret-auth-token-2024

# Configuración de Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
AUTH_TOKEN=iot-render-token-secure-2024
